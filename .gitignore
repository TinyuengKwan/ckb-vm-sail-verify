# Build artifacts
/build/
/target/

# Sail build (inside submodule)
deps/sail-riscv/build/

# Rust/Cargo (Cargo.lock is intentionally tracked for evidence reproducibility)
**/target/
**/*.rs.bk

# Sail build artifacts
sail-model/build/
proof/lean/generated/
proof/rocq/generated/
# Rocq spike: Primitives.v is Aeneas output, regenerated by scripts/rocq_spike.sh
# next to the reproduction it is compiled against. Only the reproduction source
# is tracked; a pinned copy of generated code would go stale unchecked.
proof/rocq/spike/Primitives.v
# Build products; the reproduction source next to them is tracked.
proof/rocq/spike/*.vo
proof/rocq/spike/*.vok
proof/rocq/spike/*.vos
proof/rocq/spike/*.glob
proof/rocq/spike/.*.aux
proof/rocq/spike/.lia.cache

# Failure artifacts stay local until minimized/promoted.
artifacts/*/
# Generated run report; regenerate with --json rather than committing it.
artifacts/report.json

# OS files
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Editor
.vscode/
.idea/
*.code-workspace
