diff --git a/tests/runtime_container_probe.rs b/tests/runtime_container_probe.rs
new file mode 100644
index 0000000..9fe1acc
--- /dev/null
+++ b/tests/runtime_container_probe.rs
@@ -0,0 +1,171 @@
+//! Public-API regressions run against both the original and refactored sources.
+use ckb_vm::decoder::{DefaultDecoder, InstDecoder};
+use ckb_vm::machine::VERSION2;
+use ckb_vm::registers::{A0, A7};
+use ckb_vm::{
+    CoreMachine, Debugger, DefaultCoreMachine, Error, ISA_IMC, Machine, Memory,
+    RustDefaultMachineBuilder, SparseMemory, SupportMachine, Syscalls,
+};
+use std::sync::{Arc, Mutex};
+
+type Core = DefaultCoreMachine<u64, SparseMemory<u64>>;
+type Events = Arc<Mutex<Vec<&'static str>>>;
+
+struct Token {
+    events: Events,
+    name: &'static str,
+}
+impl Drop for Token {
+    fn drop(&mut self) {
+        self.events.lock().unwrap().push(self.name);
+    }
+}
+struct Debug {
+    events: Events,
+    _token: Token,
+}
+impl Debugger<Core> for Debug {
+    fn initialize(&mut self, _: &mut Core) -> Result<(), Error> {
+        self.events.lock().unwrap().push("debug:init");
+        Ok(())
+    }
+    fn ebreak(&mut self, core: &mut Core) -> Result<(), Error> {
+        self.events.lock().unwrap().push("debug:break");
+        core.set_register(4, 9);
+        Ok(())
+    }
+}
+struct Call {
+    events: Events,
+    handled: bool,
+    _token: Token,
+}
+impl Syscalls<Core> for Call {
+    fn initialize(&mut self, _: &mut Core) -> Result<(), Error> {
+        self.events.lock().unwrap().push(if self.handled {
+            "second:init"
+        } else {
+            "first:init"
+        });
+        Ok(())
+    }
+    fn ecall(&mut self, core: &mut Core) -> Result<bool, Error> {
+        self.events.lock().unwrap().push(if self.handled {
+            "second:call"
+        } else {
+            "first:call"
+        });
+        if self.handled {
+            core.set_register(A0, 123);
+        }
+        Ok(self.handled)
+    }
+}
+fn token(events: &Events, name: &'static str) -> Token {
+    Token {
+        events: events.clone(),
+        name,
+    }
+}
+fn build(events: &Events) -> ckb_vm::DefaultMachine<Core> {
+    let cycle_token = token(events, "cycle:drop");
+    let cycle_events = events.clone();
+    RustDefaultMachineBuilder::new(Core::new(ISA_IMC, VERSION2, u64::MAX))
+        .instruction_cycle_func(Box::new(move |_| {
+            let _keep_capture = &cycle_token;
+            cycle_events.lock().unwrap().push("cycle:call");
+            7
+        }))
+        .debugger(Box::new(Debug {
+            events: events.clone(),
+            _token: token(events, "debug:drop"),
+        }))
+        .syscall(Box::new(Call {
+            events: events.clone(),
+            handled: false,
+            _token: token(events, "first:drop"),
+        }))
+        .syscall(Box::new(Call {
+            events: events.clone(),
+            handled: true,
+            _token: token(events, "second:drop"),
+        }))
+        .build()
+}
+
+#[test]
+fn actual_step_and_dynamic_dispatch_preserve_effects() {
+    let events = Events::default();
+    let mut machine = build(&events);
+    machine.set_register(1, 5);
+    machine.set_register(2, 7);
+    machine
+        .memory_mut()
+        .store_bytes(0, &0x0020_81b3u32.to_le_bytes())
+        .unwrap();
+    let mut decoder = <DefaultDecoder as InstDecoder>::new::<u64>(ISA_IMC, VERSION2);
+    machine.step(&mut decoder).unwrap();
+    assert_eq!(machine.registers()[3], 12);
+    assert_eq!(*machine.pc(), 4);
+    assert_eq!(machine.cycles(), 7);
+    machine.ebreak().unwrap();
+    assert_eq!(machine.registers()[4], 9);
+    machine.set_register(A7, 77);
+    machine.ecall().unwrap();
+    assert_eq!(machine.registers()[A0], 123);
+    assert_eq!(
+        *events.lock().unwrap(),
+        ["cycle:call", "debug:break", "first:call", "second:call"]
+    );
+}
+
+#[test]
+fn constructor_and_initialization_keep_callback_order() {
+    let events = Events::default();
+    let mut machine = build(&events);
+    let bytes = std::fs::read("tests/programs/ebreak64").unwrap().into();
+    machine
+        .load_program(&bytes, [Ok("ebreak".into())].into_iter())
+        .unwrap();
+    assert_eq!(
+        *events.lock().unwrap(),
+        ["first:init", "second:init", "debug:init"]
+    );
+}
+
+#[test]
+fn runtime_drop_order_and_exactly_once() {
+    let events = Events::default();
+    drop(build(&events));
+    assert_eq!(
+        *events.lock().unwrap(),
+        ["cycle:drop", "debug:drop", "first:drop", "second:drop"]
+    );
+}
+
+#[test]
+fn take_inner_drops_only_remaining_runtime_then_returns_core() {
+    let events = Events::default();
+    let mut machine = build(&events);
+    machine.set_register(1, 42);
+    let core = machine.take_inner();
+    assert_eq!(core.registers()[1], 42);
+    assert_eq!(
+        *events.lock().unwrap(),
+        ["cycle:drop", "debug:drop", "first:drop", "second:drop"]
+    );
+}
+
+#[test]
+fn outer_inner_is_dropped_before_runtime() {
+    let events = Events::default();
+    let cycle_token = token(&events, "cycle:drop");
+    let machine = RustDefaultMachineBuilder::new(token(&events, "inner:drop"))
+        .instruction_cycle_func(Box::new(move |_| {
+            let _keep_capture = &cycle_token;
+            0
+        }))
+        .build();
+    drop(machine);
+    assert_eq!(*events.lock().unwrap(), ["inner:drop", "cycle:drop"]);
+}
