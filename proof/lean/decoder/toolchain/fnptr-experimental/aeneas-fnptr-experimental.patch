+(* Experimental first-order pointers. Unsupported signatures remain errors.
+   In particular, do not erase zero-argument thunks or borrowed contracts. *)
+let check_fn_ptr_sig span infos (binder : fun_sig region_binder) : fun_sig =
+  let sg = binder.binder_value in
+  let scalar = function TLiteral _ -> true | _ -> false in
+  let result_shape = function
+    | TLiteral _ -> true
+    | TAdt { generics; _ } ->
+        generics.regions = [] && generics.trait_refs = []
+        && generics.const_generics = [] && List.for_all scalar generics.types
+    | _ -> false
+  in
+  [%cassert_opt_span] span
+    (binder.binder_regions = [] && not sg.is_unsafe && sg.abi = AbiRust
+    && not sg.is_variadic && sg.inputs <> []
+    && List.for_all scalar sg.inputs && result_shape sg.output)
+    "Unsupported function pointer signature (requires safe Rust scalar inputs and closed result)";
+  Option.iter
+    (fun infos ->
+      [%cassert_opt_span] span
+        (not (ty_has_borrows span infos sg.output))
+        "Borrowed function pointer result is not supported")
+    infos;
+  [%cassert_opt_span] span (not !Config.use_fuel)
+    "Function pointers with fuel are not supported";
+  sg
+
