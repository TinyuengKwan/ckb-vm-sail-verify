+(** Experimental factoring of a terminal return leaf out of a short-circuit
+    ladder. Every sibling is empty and every nested switch is in tail position:
+    reaching the leaf sets a fresh boolean, and the unchanged leaf runs just
+    after the ladder. No operation can be crossed on that path. We additionally
+    reject payloads mentioning a local assigned by the guard, to avoid making
+    their initialization depend on a boolean correlation at a symbolic join. *)
+let factor_return_guards (_ : crate) (f : fun_decl) : fun_decl =
+  if Sys.getenv_opt "AENEAS_FACTOR_RETURN_GUARDS" <> Some "1" then f
+  else match f.body with
+  | StructuredBody body ->
+      let new_locals = ref [] in
+      let _, fresh = LocalId.mk_stateful_generator_starting_at_id
+        (LocalId.of_int (List.length body.locals.locals)) in
+      let bool_ty = TLiteral TBool in
+      let cleanup (b : block) =
+        List.for_all (fun st -> match st.kind with Nop | StorageDead _ -> true | _ -> false) b.statements in
+      let boolean_switch data = match data.scrutinee with
+        | SwitchValue (Move p | Copy p) -> p.ty = bool_ty
+        | SwitchValue (Constant c) -> c.ty = bool_ty
+        | _ -> false in
+      let straight st =
+        match st.kind with
+        | Switch _ | Loop _ | Return | Break _ | Continue _ -> false
+        | _ -> not (statement_has_break_continue_return st) in
+      let rec extract (b : block) =
+        match List.rev b.statements with
+        | last :: rev_prefix when List.for_all straight rev_prefix ->
+            let prefix = List.rev rev_prefix in
+            (match last.kind with
+            | Return -> Some (0, b, fun leaf -> leaf)
+            | Switch (data, [left; right]) when boolean_switch data ->
+                let child, sibling, left_child =
+                  if cleanup right then (left, right, true)
+                  else (right, left, false) in
+                if not (cleanup sibling) then None else
+                (match extract child with
+                | None -> None
+                | Some (depth, payload, rebuild) ->
+                    Some (depth + 1, payload, fun leaf ->
+                      let child = rebuild leaf in
+                      let branches = if left_child then [child; sibling] else [sibling; child] in
+                      { b with statements = prefix @ [{ last with kind = Switch (data, branches) }] }))
+            | _ -> None)
+        | _ -> None in
+      let visitor = object
+        inherit [_] map_statement as super
+        method! visit_block env b =
+          let transform st =
+            let shell = { b with statements = [st] } in
+            match extract shell with
+            | Some (depth, payload, rebuild) when depth >= 2 ->
+                let guard = rebuild { payload with statements = [] } in
+                let assigned = ref LocalId.Set.empty in
+                let projected_write = ref false in
+                let record_place (p : place) = match p.kind with
+                  | PlaceLocal id -> assigned := LocalId.Set.add id !assigned
+                  | _ -> projected_write := true in
+                let writes = object
+                  inherit [_] iter_statement as parent
+                  method! visit_Assign env p rv =
+                    record_place p; parent#visit_Assign env p rv
+                  method! visit_Call env call unwind =
+                    record_place call.dest; parent#visit_Call env call unwind
+                end in
+                writes#visit_block () guard;
+                let mentioned = ref LocalId.Set.empty in
+                let reads = object
+                  inherit [_] iter_statement
+                  method! visit_PlaceLocal _ id =
+                    mentioned := LocalId.Set.add id !mentioned
+                end in
+                reads#visit_block () payload;
+                if !projected_write || not (LocalId.Set.is_empty
+                  (LocalId.Set.inter !assigned !mentioned)) then
+                  [super#visit_statement env st]
+                else begin
+                  let id = fresh () in
+                  new_locals := { index = id; local_ty = bool_ty;
+                    name = Some "return_guard"; span = st.span } :: !new_locals;
+                  let place = { kind = PlaceLocal id; ty = bool_ty } in
+                  let literal value : constant_expr = { kind = CLiteral (VBool value); ty = bool_ty } in
+                  let assign value = { st with statement_id = StatementId.zero;
+                    kind = Assign (place, Use (Constant (literal value), NoRetag));
+                    comments_before = [] } in
+                  let guard = rebuild { payload with statements = [assign true] } in
+                  let data = { scrutinee = SwitchValue (Move place);
+                    branches = [(literal true, BranchId.of_int 0)];
+                    fallback = Some (BranchId.of_int 1) } in
+                  let finish = { st with statement_id = StatementId.zero;
+                    kind = Switch (data, [payload; { payload with statements = [] }]);
+                    comments_before = [] } in
+                  Printf.eprintf "FACTOR depth=%d span=%s\n%!" depth (Errors.raw_span_to_string st.span);
+                  assign false :: guard.statements @ [finish]
+                end
+            | _ -> [super#visit_statement env st] in
+          { b with statements = List.concat_map transform b.statements }
+      end in
+      let new_body = visitor#visit_block () body.body in
+      { f with body = StructuredBody { body with body = new_body;
+        locals = { body.locals with locals = body.locals.locals @ List.rev !new_locals } } }
+  | _ -> f
+
