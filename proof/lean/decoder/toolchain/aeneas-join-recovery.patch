diff --git a/src/interp/InterpReduceCollapse.ml b/src/interp/InterpReduceCollapse.ml
index 379bcd2d..75adab0d 100644
--- a/src/interp/InterpReduceCollapse.ml
+++ b/src/interp/InterpReduceCollapse.ml
@@ -1316,6 +1316,38 @@ let collapse_ctx config (span : Meta.span)
       None) (fresh_abs_kind : abs_kind) ~(recoverable : bool)
     ~(with_abs_conts : bool) (ctx : eval_ctx) : eval_ctx =
   [%ldebug "Initial ctx:\n" ^ eval_ctx_to_string ctx];
+  (* The borrow/loan maps used below do not support concrete shared borrows
+     nested in the values of abstract shared loans.  Do not attempt a partial
+     merge: reject this join before modifying the context.  The caller may
+     preserve the original branch contexts and duplicate their continuations.
+     Strict joins and non-recoverable callers still report an error. *)
+  let check_shared_value =
+    object
+      inherit [_] iter_tvalue as super
+      method! visit_borrow_content env bc =
+        match bc with
+        | VSharedBorrow _ ->
+            [%craise_recover] recoverable span
+              "Context collapse does not support concrete shared borrows in abstract shared loans"
+        | _ -> super#visit_borrow_content env bc
+    end
+  in
+  let check_abs =
+    object
+      inherit [_] iter_tavalue as super
+      method! visit_aloan_content env lc =
+        (match lc with
+        | ASharedLoan (_, _, sv, _) -> check_shared_value#visit_tvalue () sv
+        | _ -> ());
+        super#visit_aloan_content env lc
+    end
+  in
+  let frozen = ctx_get_frozen_abs_set ctx in
+  env_iter_abs
+    (fun abs ->
+      if not (AbsId.Set.mem abs.abs_id frozen) then
+        List.iter (check_abs#visit_tavalue ()) abs.avalues)
+    ctx.env;
   let merge_funs =
     mk_collapse_ctx_merge_duplicate_funs span fresh_abs_kind ~recoverable
       ~with_abs_conts ctx
